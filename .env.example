# Copy to .env and fill in. Generate the two keys with:
#   openssl rand -hex 32

# --- Image ------------------------------------------------------------------
# Image repository the stack pulls. Empty/unset = ghcr.io/ariazonaa/uploader.
# Change it only to use a mirror or your own build.
UPLOADER_IMAGE=
# Image tag. Empty/unset = :latest, which moves with every release. For
# production, pin a specific release tag or commit SHA so an upgrade only
# happens when you change this line, e.g.:
#   UPLOADER_TAG=<tag or commit SHA>
UPLOADER_TAG=

# --- Network (optional) -----------------------------------------------------
# The stack runs on its own bridge network with fixed addresses so a reverse
# proxy on the host can reach the app at UPLOADER_APP_IP:8080. Change these only
# if the default subnet clashes with a network you already have.
# Empty/unset = 10.89.0.40/29, gateway 10.89.0.41, app 10.89.0.42, db 10.89.0.43.
UPLOADER_SUBNET=
UPLOADER_GATEWAY=
UPLOADER_APP_IP=
UPLOADER_POSTGRES_IP=

# --- Required ---------------------------------------------------------------
# 32-byte keys as 64 hex chars each (DIFFERENT values!). Secure the session cookie.
UPLOADER_SESSION_HASH_KEY=
UPLOADER_SESSION_BLOCK_KEY=

# Postgres password (used by both the app connection string and the db container).
POSTGRES_PASSWORD=change-me

# --- Configured in the admin dashboard (Settings), NOT here -----------------
# App name, public URL, embeds, branding (logo, login heading/subtext/background,
# powered-by badge), legal notice, upload size, EXIF stripping, encryption
# default, retention, trash retention and blocked MIME types are configured in
# the admin dashboard (Settings) — they are intentionally NOT env-configurable.

# --- Optional ---------------------------------------------------------------
# Set to true ONLY when running behind a reverse proxy you control. Enables
# honoring X-Forwarded-Proto/Host/For. Leave false otherwise — these headers are
# client-spoofable and would let attackers bypass the login rate limiter.
#
# The bundled stack publishes no host port and always sits behind a reverse
# proxy, hence true here. Set it to false if you publish port 8080 directly.
UPLOADER_TRUST_PROXY=true

# Only with UPLOADER_TRUST_PROXY: read the client IP from this one header (its
# rightmost entry) instead of X-Forwarded-For with X-Real-IP as fallback. Set it
# when your proxy writes only one of them (e.g. X-Real-IP, CF-Connecting-IP) --
# the other one would arrive straight from the client. Empty = default.
UPLOADER_CLIENT_IP_HEADER=

# --- Scaling (optional) -----------------------------------------------------
# Read replica for read-heavy public queries (share/raw/list). Writes always go
# to UPLOADER_DATABASE_URL. Leave empty to use a single database.
UPLOADER_DATABASE_REPLICA_URL=
# Connection-pool tuning (0 = built-in defaults: 12/2/1h/30m).
UPLOADER_DB_MAX_CONNS=0
UPLOADER_DB_MIN_CONNS=0
UPLOADER_DB_MAX_CONN_LIFETIME=
UPLOADER_DB_MAX_CONN_IDLE_TIME=

# Self-service registration: "off" (default, only admins create accounts) or
# "invite" (anyone with a valid single-use invite code can register; admins
# generate codes).
UPLOADER_REGISTRATION=off

# At-rest blob encryption key (64 hex chars = 32 bytes; openssl rand -hex 32).
# Optional, but set it before you enable encryption in production: when it is
# empty the key is DERIVED from UPLOADER_SESSION_BLOCK_KEY, which means rotating
# the session key -- the normal response to a suspected leak -- makes every
# encrypted blob unreadable. Stored 2FA secrets are encrypted with the session
# block key regardless, so a rotation always invalidates those; re-enrolling
# authenticators is the recovery path there.
UPLOADER_ENCRYPTION_KEY=

# Web Push (browser notifications). Generate a keypair with: uploader vapid
# Leave empty to disable push.
UPLOADER_VAPID_PUBLIC_KEY=
UPLOADER_VAPID_PRIVATE_KEY=
UPLOADER_VAPID_SUBJECT=mailto:admin@example.com

# Set to false ONLY for local plain-HTTP testing (cookies won't work over http otherwise).
UPLOADER_SECURE_COOKIES=true

# Seed password for the bootstrap account (used by: uploader user create).
UPLOADER_SEED_PASSWORD=
