# Secrets & local data
.env
/data/
*.db

# Go
/backend/uploader
/backend/uploader.exe
*.test

# Node / frontend
node_modules/
/frontend/dist/
# Written by every tsc -b run.
*.tsbuildinfo

# Embedded SPA build artifacts (regenerated by the Docker build)
/backend/internal/web/dist/assets/

# Syncthing conflict copies. In a workflow directory one would run as a second
# CI workflow; anywhere else it would be published by the GitHub sync.
*.sync-conflict-*

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Swagger UI assets are copied out of node_modules at build time
# (frontend/scripts/vendor-swagger.mjs), not checked in.
/frontend/public/vendor/
